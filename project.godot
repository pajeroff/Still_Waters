; Godot Engine project configuration.
; «Тихий Омут» — isometric movement prototype, Godot 4.7.
config_version=5

[application]
config/name="Тихий Омут"
run/main_scene="res://World.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[layer_names]
2d_physics/layer_1="Player"
2d_physics/layer_2="World"
2d_physics/layer_3="Water"
2d_physics/layer_4="NPC"
2d_physics/layer_5="Interactable"
2d_physics/layer_6="Trigger"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/texture_filter=0
environment/defaults/default_clear_color=Color(0.055, 0.106, 0.133, 1)
